# Copy to .env and fill locally. NEVER commit real values.
PORT=3000
NODE_ENV=development

# Mock mode: when true, no real Google API call is made.
GA4_MOCK=true

# Google OAuth (not used yet — leave empty for now)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Supabase Postgres (persistence — not used yet)
DATABASE_URL=

# Encryption key for token-at-rest (not used yet)
ENCRYPTION_KEY=
